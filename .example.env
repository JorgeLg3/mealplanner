DEBUG=true
SECRET_KEY=something_here
# Comma-separated. Production: the hostname/IP you browse to, e.g. 192.168.1.50,meals.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme (and port if not 80/443), e.g. http://192.168.1.50:8002,https://meals.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Optional: sites allowed to embed the app in a frame 
FRAME_ANCESTORS=
# Optional: set to None only if embedding from a different site (cookies then need HTTPS)
COOKIE_SAMESITE=Lax
